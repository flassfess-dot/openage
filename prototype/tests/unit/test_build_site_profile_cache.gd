extends SceneTree
const Catalog := preload("res://scripts/resource_catalog.gd")
const World := preload("res://scripts/simulation_world.gd")
const Task := preload("res://scripts/build_site_task.gd")
const Data := preload("res://scripts/isolated_task_data.gd")
var failures: Array[String] = []
func _initialize() -> void:
	var catalog := Catalog.new()
	catalog.load_generated_data()
	var world := World.new(Vector2i(24,24))
	world.set_gamespec(catalog.gamespec_data)
	world.set_object_catalog(catalog.object_catalog_data)
	world.set_runtime_catalog(catalog.runtime_catalog_data)
	world.navigation_grid.configure_terrain(func(_cell):return "grass")
	world.add_unit(1,"villager",Vector2(8,8),false)
	for type_id in range(4): world.set_resource_amount(1,type_id,10000)
	var first := Task.capture(world,1,["house"])
	var second := Task.capture(world,1,["house"])
	check(is_same(first["profiles"]["house"]["metadata"],second["profiles"]["house"]["metadata"]),"unchanged catalogs reuse immutable profiles")
	check(first["profiles"].is_read_only() and first["workers"].is_read_only() and first["buildings"].is_read_only(),"producer roots are immutable")
	check(Data.is_detached(first),"all published roots remain detached")
	world.set_resource_amount(1,1,0)
	var poor := Task.capture(world,1,["house"])
	check(first["profiles"]["house"]["affordable"] and not poor["profiles"]["house"]["affordable"],"affordability is current and old publications stay unchanged")
	var replacement: Dictionary = catalog.runtime_catalog_data.duplicate(true)
	replacement["archetypes"]["house"]["runtime"]["qa_profile_revision"] = 1
	world.set_runtime_catalog(replacement)
	var changed := Task.capture(world,1,["house"])
	check(changed["profiles"]["house"]["metadata"].get("qa_profile_revision") == 1 and not first["profiles"]["house"]["metadata"].has("qa_profile_revision"),"catalog reconfiguration replaces the profile without mutating old data")
	replacement["archetypes"]["house"]["runtime"]["qa_profile_revision"] = 2
	world.set_runtime_catalog(replacement)
	check(Task.capture(world,1,["house"])["profiles"]["house"]["metadata"].get("qa_profile_revision") == 2,"reconfiguration invalidates even with the same catalog identity")
	var cache := Task._capture_cache(world,1)
	for index in range(Task.MAX_PROFILES + 8): Task._profile_template(world,cache,"qa_missing_"+str(index))
	check(cache["profiles"].size() <= Task.MAX_PROFILES and cache["profile_bytes"] <= Task.MAX_PROFILE_BYTES,"profile retention respects both limits")
	var malformed: Dictionary = world.add_building(500,"house",Vector2(12,12),1)
	malformed["footprint"]["qa_object"] = RefCounted.new()
	check(Task.capture(world,1,["house"]).is_empty(),"invalid actor graphs cannot acquire a trusted publication root")
	world.shutdown_derived_state()
	for failure in failures: push_error(failure)
	print("Build-site profile cache: %d failures" % failures.size())
	quit(0 if failures.is_empty() else 1)
func check(value: bool, message: String) -> void:
	if not value: failures.append(message)
