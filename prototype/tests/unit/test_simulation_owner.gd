extends SceneTree
const Owner := preload("res://scripts/simulation_owner.gd")
const World := preload("res://scripts/simulation_world.gd")
const Controller := preload("res://scripts/game_controller.gd")
const Runtime := preload("res://scripts/ai_runtime_coordinator.gd")
const Decisions := preload("res://scripts/ai_decision_queue.gd")
const Store := preload("res://scripts/ai_observation_store.gd")
const Coordinator := preload("res://scripts/isolated_task_coordinator.gd")
const Replay := preload("res://scripts/replay_system.gd")
const Commands := preload("res://scripts/commands.gd")
var failures: Array[String] = []
func check(value: bool, message: String) -> void:
	if not value: failures.append(message)
func _initialize() -> void:
	var fast := World.new(Vector2i(16,16))
	var reference := World.new(Vector2i(16,16))
	for world in [fast,reference]:
		world.set_simulation_seed(512)
		world.add_unit(1,"villager",Vector2(4,4),false)
		world.add_unit(2,"clubman",Vector2(13,13),false)
		world.add_resource("tree",Vector2(7,7),100)
	var controller := Controller.new(fast)
	var expected := Controller.new(reference)
	var runtime := Runtime.new()
	var coordinator := Coordinator.new()
	runtime.configure(fast,controller,[],Decisions.new(),Store.new(),coordinator)
	controller.set_before_fixed_tick(Callable(runtime,"queue_commands"))
	var owner := Owner.new()
	var replay := Replay.new()
	for index in range(80):
		if index % 16 == 0:
			for target in [controller,expected]:
				target.enqueue_command(Commands.MoveCommand.new(target.tick_index+1,[1],Vector2(5+index%6,5+index%7)),false,1)
		check(owner.submit(controller,runtime,0.05,1,2,index),"one job accepted")
		check(not owner.submit(controller,runtime,0.05,1,2,index),"a second outstanding job is rejected")
		expected.advance_frame(0.05,1,2)
		var result := owner.take()
		check(int(result["tick"]) == expected.tick_index,"completed tick order is identical")
		check(not owner.pending and not owner.ready(),"taking result returns exclusive world ownership")
		check(replay.world_state_hash(fast,controller.tick_index,controller) == replay.world_state_hash(reference,expected.tick_index,expected),"commands, movement, combat and fog hash match at %d"%index)
	check(runtime.render_frame_override == -1,"worker releases the frame-budget override")
	check(runtime.capture_budget_override == -1 and runtime.decisions.preparation_budget_usec == runtime.decisions.PREPARATION_BUDGET_USEC and controller.frame_simulation_budget_usec == controller.FRAME_SIMULATION_BUDGET_USEC,"owner budgets never leak into sequential commands, replay or save/load")
	check(controller.yield_ready_tick_for_presentation,"owner never changes the sequential presentation deadline policy")
	owner.submit(controller,runtime,0.05,1,2,81)
	owner.shutdown()
	check(not owner.thread.is_started() and not owner.pending,"shutdown joins an outstanding request and the persistent thread")
	runtime.shutdown()
	coordinator.shutdown()
	fast.shutdown_derived_state()
	reference.shutdown_derived_state()
	for failure in failures: push_error(failure)
	print("Simulation owner: %d failures"%failures.size())
	quit(0 if failures.is_empty() else 1)
