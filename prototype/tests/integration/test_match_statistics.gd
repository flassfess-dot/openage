extends SceneTree
const World := preload("res://scripts/simulation_world.gd")
const Controller := preload("res://scripts/game_controller.gd")
const Checkpoint := preload("res://scripts/game_checkpoint.gd")
const Replay := preload("res://scripts/replay_system.gd")
const Statistics := preload("res://scripts/match_statistics.gd")
const Catalog := preload("res://scripts/resource_catalog.gd")
var failures: Array[String] = []

func _initialize() -> void:
	var world := World.new(Vector2i(24,24))
	world.player_registry.configure([{"team": 1}, {"team": 2}])
	var catalog := Catalog.new()
	catalog.load_generated_data()
	world.set_gamespec(catalog.gamespec_data)
	world.set_object_catalog(catalog.object_catalog_data)
	world.set_runtime_catalog(catalog.runtime_catalog_data)
	var unit := world.add_unit(1, "clubman", Vector2(4,4), false)
	world.add_unit(2, "clubman", Vector2(18,18), false)
	var controller := Controller.new(world)
	controller.start_recording(41721, false)
	world.configure_victory_rules([])
	for _i in range(105): controller._run_fixed_tick(1,2)
	check(world.match_statistics.samples.size() >= 2, "fixed ticks record initial and later populations")
	check(world.match_statistics.samples[0]["teams"][1]["population"] == 1, "history uses actual source-backed population")
	world.begin_event_capture()
	var transient := world.add_unit(1, "clubman", Vector2(6,4), false)
	world.begin_entity_death(transient, {"team":2})
	world.end_event_capture()
	controller._forward_domain_events()
	check(world.match_statistics.teams[1]["peak_population"] == 2 and world.get_population(1) == 1, "population peak survives creation and death between samples")
	check(world.match_statistics.teams[1]["lost"] == 1 and world.match_statistics.teams[2]["kills"] == 1, "actual death events attribute losses and kills to their players")
	var gameplay_hash := Replay.new().world_state_hash(world, controller.tick_index, controller)
	world.match_statistics.consume(world, "resource_gathered", {"worker_id": unit["id"], "resource_type_id": 3, "amount": 17}, controller.tick_index)
	world.match_statistics.consume(world, "research_complete", {"team": 1, "technology_id": 102}, controller.tick_index)
	check(world.match_statistics.teams[1]["gathered"][3] == 17, "resources come from actual gather events")
	check(world.match_statistics.markers[-1]["value"] == 102, "age changes retain their exact event tick")
	check(Replay.new().world_state_hash(world, controller.tick_index, controller) == gameplay_hash, "statistics cannot change gameplay replay hashes")
	var definition := {"players": [{"team":1},{"team":2}], "map": {"size":Vector2i(24,24)}}
	var checkpoint := Checkpoint.capture(world, controller, definition, {"size":Vector2i(24,24)})
	var saved := world.match_statistics.state()
	var restored := World.new(Vector2i(24,24))
	var restored_controller := Controller.new(restored)
	check(Checkpoint.restore(Checkpoint.unpack(Checkpoint.pack(checkpoint)), restored, restored_controller), "checkpoint including TimeLine restores")
	check(restored.match_statistics.state() == saved, "history and cumulative counters survive save/load exactly")
	for _i in range(100): restored_controller._run_fixed_tick(1,2)
	check(restored.match_statistics.samples.size() > saved["samples"].size(), "history continues after restore")
	var legacy := checkpoint.duplicate(true)
	legacy.erase("match_statistics")
	check(Checkpoint.restore(legacy, restored, restored_controller), "existing current-format checkpoints remain loadable")
	check(restored.match_statistics.partial and restored.match_statistics.start_tick == controller.tick_index, "legacy history is explicitly marked as partial")
	var invalid := checkpoint.duplicate(true)
	invalid["match_statistics"]["samples"] = [{"tick": 1, "teams": {1: {"age": "invalid"}}}]
	check(not Checkpoint.validate(invalid), "malformed statistics cannot reach the UI")
	var stats := Statistics.new()
	stats.begin(world)
	for i in range(Statistics.MAX_SAMPLES + 10): stats.sample(world, (i+1)*100, true)
	check(stats.samples.size() <= Statistics.MAX_SAMPLES and stats.samples[0]["tick"] == 0, "long matches retain bounded history including the beginning")
	world.match_statistics.consume(world, "match_completed", {}, 200)
	world.match_statistics.sample(world, 200, true)
	var final_count := world.match_statistics.samples.size()
	world.match_statistics.sample(world, 201, true)
	check(world.match_statistics.samples.size() == final_count, "TimeLine stops at match completion")
	world.reset_game(false)
	check(world.match_statistics.samples.is_empty() and world.match_statistics.teams.is_empty(), "restart discards the previous match history")
	world.shutdown_derived_state()
	restored.shutdown_derived_state()
	for failure in failures: push_error(failure)
	print("Match statistics/checkpoint: %d failures" % failures.size())
	quit(0 if failures.is_empty() else 1)

func check(value: bool, message: String) -> void:
	if not value: failures.append(message)
