extends SceneTree
const Catalog=preload("res://scripts/resource_catalog.gd")
const World=preload("res://scripts/simulation_world.gd")
const Controller=preload("res://scripts/game_controller.gd")
const Commands=preload("res://scripts/commands.gd")
const Snapshot=preload("res://scripts/simulation_snapshot.gd")
const Store=preload("res://scripts/ai_observation_store.gd")
const Transport=preload("res://scripts/ai_transport_planner.gd")
const Planner=preload("res://scripts/ai_capability_planner.gd")
const Support=preload("res://scripts/ai_support_planner.gd")
const State=preload("res://scripts/ai_strategy_state.gd")
const Budget=preload("res://scripts/ai_plan_budget.gd")
const Regions=preload("res://scripts/ai_region_model.gd")
const Checkpoint=preload("res://scripts/game_checkpoint.gd")
var failures: Array[String]=[]
func _initialize() -> void:
	var catalog=Catalog.new(); catalog.load()
	for count in [4,8]: verify_team(catalog,count)
	for failure in failures: push_error(failure)
	print("AI team capabilities 2v2/4v4: ",failures.size()," failures"); quit(0 if failures.is_empty() else 1)
func configured(catalog):
	var world=World.new(Vector2i(40,40))
	world.set_gamespec(catalog.gamespec_data); world.set_object_catalog(catalog.object_catalog_data); world.set_graphics_catalog(catalog.graphics_catalog_data); world.set_runtime_catalog(catalog.runtime_catalog_data); world.set_terrain_catalog(catalog.terrain_catalog_data)
	return world
func verify_team(catalog,count: int) -> void:
	var world=configured(catalog)
	for team in range(1,count+1):
		world.set_team_civilization(team,13); world.grant_technology(team,101)
		world.add_unit(team,"villager",Vector2(30.5,4.5+team*3.0),false)
		world.set_population_cap(team,50); world.set_population_housing(team,50)
		for type_id in range(4): world.set_resource_amount(team,type_id,1000)
	for left in range(1,count+1):
		for right in range(left+1,count+1): world.set_alliance(left,right,(left<=count/2)==(right<=count/2))
	var ship: Dictionary=world.add_unit(2,"transport",Vector2(1.5,10.5),false)
	var passenger: Dictionary=world.add_unit(1,"clubman",Vector2(2.6,10.5),false)
	var repairer: Dictionary=world.add_unit(2,"villager",Vector2(3.5,13.5),false)
	var asset: Dictionary=world.add_building(900,"granary",Vector2(6.5,13.5),1)
	world.set_entity_field(asset,"hp",float(asset["max_hp"])-50.0)
	world.update_fog_of_war()
	var controller=Controller.new(world)
	var snapshot:=observe(world,1)
	var visible: Array=snapshot["units"].filter(func(u): return int(u["id"])==int(ship["id"]))
	check(visible.size()==1 and not visible[0].get("components",{}).get("cargo",{}).has("passenger_ids"),"allied manifest remains private")
	check(visible.size()==1 and not visible[0].get("components",{}).get("cargo",{}).has("count"),"allied cargo count remains private")
	var goal:={"type":"attack","target_domain":"land","position":Vector2(20.5,20.5),"home":Vector2(3.5,10.5),"competitive":true,"adaptive_strategy":true,"needs_transport":true,"expeditions":{}}
	var boards: Array=Transport.plan(snapshot,0,1,goal).filter(func(c): return c.command_type()=="board" and int(c.params.get("transport_id",-1))==int(ship["id"]))
	check(boards.size()==1,"AI requests boarding without reading allied cargo")
	if boards.is_empty():
		var land:=Transport._known_land_component(Vector2(goal["position"]),snapshot.get("navigation",{}))
		print("BOARD_DIAGNOSTIC ",JSON.stringify({"allies":snapshot["player_state"].get("mutual_allies",[]),"ship":visible,"passenger":snapshot["units"].filter(func(u): return int(u["id"])==int(passenger["id"])),"component_size":land.size(),"own_membership":snapshot["units"].filter(func(u): return int(u["team"])==1).map(func(u): return {"id":u["id"],"in_target":land.has(Vector2i(Vector2(u["pos"]))),"worker":u.get("components",{}).get("worker",{}).get("enabled",false)}),"proposals":Transport.plan(snapshot,0,1,goal).map(func(c): return c.command_type())}))
	if not boards.is_empty(): check(bool(submit(controller,boards[0],1).get("accepted",false)),"AI boarding passes the ordinary ownership boundary")
	for tick in range(20): controller.advance_frame(0.05,1,2)
	check(world.transport_system.embarked_units.has(int(passenger["id"])),"own troop actually boards allied transport")
	var intent=Commands.TeamIntentCommand.new(controller.tick_index,2,"resource",Vector2(3.5,13.5),0,150)
	check(bool(submit(controller,intent,1).get("accepted",false)),"team intention reaches a mutual ally")
	var donor:=observe(world,2); var state=State.new(); state.goal={"home":Vector2(3.5,13.5)}
	var proposals: Array=Planner.plan(donor,controller.tick_index,2,{"competitive":true},state,Budget.new(donor["player_state"],donor["buildings"]),{},Regions.new())
	var tribute: Array=proposals.filter(func(c): return c.command_type()=="tribute")
	var before: int=world.get_resource_amount(1,0)
	check(tribute.size()==1,"recipient responds with affordable resource help")
	if not tribute.is_empty(): check(bool(submit(controller,tribute[0],2).get("accepted",false)),"resource help is paid through TributeCommand")
	check(world.get_resource_amount(1,0)>before,"help changes the actual recipient stockpile")
	check(int(world.economy_system.resource_ledger_by_team.get(1,{}).get("income",[0,0,0,0])[0])==0,"tribute does not masquerade as gathering income")
	var repairs: Array=Support.plan(donor,controller.tick_index,2,{},state).filter(func(c): return c.command_type()=="repair" and int(repairer["id"]) in c.unit_ids)
	check(not repairs.is_empty(),"AI proposes repair of a visible allied building")
	if not repairs.is_empty(): submit(controller,repairs[0],2)
	var checkpoint:=Checkpoint.capture(world,controller,{}, {})
	check(Checkpoint.validate(checkpoint),"team intents and allied cargo form a valid checkpoint")
	var restored=configured(catalog); var resumed=Controller.new(restored)
	check(Checkpoint.restore(checkpoint,restored,resumed),"team checkpoint restores")
	check(restored.ai_distress_system.team_intents==world.ai_distress_system.team_intents and restored.transport_system.embarked_units.keys()==world.transport_system.embarked_units.keys(),"intents and embarked ownership survive save")
	world.set_alliance(1,2,false)
	check(world.ai_distress_system.intents_for_team(world,2).is_empty(),"broken alliance immediately withdraws team information")
	check(world.find_unit(int(passenger["id"]))!=null or world.transport_system.embarked_units.has(int(passenger["id"])),"diplomacy change never discards a passenger")
	world.shutdown_derived_state(); restored.shutdown_derived_state()
func observe(world,team: int) -> Dictionary:
	return Store.new().observe_with_queries(world,0,team,{"compact_entities":true,"include_ai_profiles":true,"include_projectiles":false,"include_scenario":false,"include_navigation":true})
func submit(controller,command,team: int) -> Dictionary:
	controller.enqueue_command(command,true,team); controller.process_commands(); return controller.get_command_result(command.sequence_id)
func check(value: bool,message: String) -> void:
	if not value: failures.append(message)
